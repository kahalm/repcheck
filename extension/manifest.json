{
  "manifest_version": 3,
  "name": "RepCheck — Opening Repertoire Checker",
  "version": "1.73.4",
  "description": "Markiert Abweichungen vom Eröffnungsrepertoire auf chess.com & lichess (PGN oder RookHub); chessable: FEN-Tools + RookHub.",
  "homepage_url": "https://github.com/kahalm/repcheck",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://lichess.org/*"
      ],
      "js": [
        "chess.min.js",
        "lib/repertoire-text.js",
        "lib/chesscom-moves.js",
        "lib/i18n.js",
        "lib/site-adapters.js",
        "content/store.js",
        "content/rookhub-api.js",
        "content/game-meta.js",
        "content/styles.js",
        "content/overview.js",
        "content/local-repertoire.js",
        "content/panel.js",
        "content/floating.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chessable.com/*",
        "https://chessable.com/*"
      ],
      "js": [
        "chessable-token.js",
        "lib/chessable-crawl.js",
        "lib/chessable-course-names.js",
        "lib/chessable-course-id.js",
        "lib/chessable-feedback.js",
        "lib/i18n.js",
        "lib/rookhub-client.js",
        "chessable-activity/activity-tracker.js",
        "chessable-activity/course-context.js",
        "chessable-activity/capture-harvest.js",
        "chessable-activity/banners.js",
        "chessable-activity/chessable-fetch.js",
        "chessable-activity/crawl-report.js",
        "chessable-activity/course-import.js",
        "chessable-activity/import-bridge.js",
        "chessable-activity/progress-overlay.js",
        "chessable-activity.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chessable.com/*",
        "https://chessable.com/*"
      ],
      "js": [
        "chessable-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.chessable.com/*",
        "https://chessable.com/*"
      ],
      "js": [
        "lib/chessable-course-names.js",
        "lib/chessable-course-id.js",
        "lib/chessable-feedback.js",
        "lib/fen-extract.js",
        "chessable-fen/fen-feedback.js",
        "chessable-fen/fen-pool.js",
        "chessable-fen/zen-extras.js",
        "chessable-fen/zen.js",
        "chessable-fen/fen-toolbar.js",
        "chessable-fen.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "RepCheck"
  },
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chesscom-repertoire-checker@kahalm.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
